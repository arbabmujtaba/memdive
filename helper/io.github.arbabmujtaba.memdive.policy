<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Memdive</vendor>
  <vendor_url>https://github.com/arbabmujtaba/memdive</vendor_url>
  <action id="io.github.arbabmujtaba.memdive.helper">
    <description>Free kernel memory caches</description>
    <message>Memdive needs to drop kernel memory caches</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/memdive-helper</annotate>
  </action>
</policyconfig>
